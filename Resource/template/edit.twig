{% extends '@admin/default_frame.twig' %}
{% block title %}メール送信設定の編集{% endblock %}
{% block sub_title %}パスワード・証明書の更新{% endblock %}
{% block stylesheet %}<link rel="stylesheet" href="{{ path('cert_smtp_styles') }}">{% endblock %}
{% block main %}
<div class="card rounded border-0 mb-4"><div class="card-body">
<h2 class="h4">メール送信設定の編集</h2>
<div class="alert alert-info"><ul class="mb-0"><li>変更したい項目だけ書き換えて「保存する」を押します。</li><li><strong>パスワードを変更しない場合は空欄</strong>のままにします。</li><li>証明書・秘密鍵も、変更しない場合はファイルを選び直す必要はありません。</li><li>以前のメールと送信履歴は削除しません。この操作だけでメールは送信しません。</li></ul></div>
{% if edit.active %}<p class="alert alert-warning">現在メール送信に使用中の設定です。接続先やパスワードなどを変更すると、安全のため配送を保留します。保存後は管理担当者へメール送信の再開確認を依頼してください。</p>{% endif %}
<form method="post" action="{{ path('cert_smtp_account_update') }}" enctype="multipart/form-data" autocomplete="off">
<input type="hidden" name="_token" value="{{ csrf_token('cert_smtp_accounts') }}"><input type="hidden" name="account_id" value="{{ edit.id }}"><input type="hidden" name="revision" value="{{ edit.revision }}"><input type="hidden" name="MAX_FILE_SIZE" value="262144">
<div class="px-3">{% include '@CertSmtp/account_fields.twig' %}</div>
<div class="mt-4 d-flex gap-2"><a class="btn btn-secondary" href="{{ path('cert_smtp_settings') }}">保存せず戻る</a><button class="btn btn-primary" type="submit">保存する</button></div>
</form></div></div>
{% endblock %}
