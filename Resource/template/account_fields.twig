{% macro row(name,title,help,type='text',value='',required=true) %}
<div class="mb-3 row align-items-start"><label class="col-md-3 col-form-label" for="smtp-{{ name }}">{{ title }}{% if required %} <span class="text-danger">*</span>{% endif %}</label><div class="col-md-5"><input class="form-control" type="{{ type }}" id="smtp-{{ name }}" name="{{ name }}" value="{{ value }}"{% if required %} required{% endif %} aria-describedby="smtp-help-{{ name }}"{% if type=='password' %} autocomplete="new-password"{% endif %}{% if type=='number' %} min="1" max="65535"{% endif %}></div><div class="col-md-4"><small id="smtp-help-{{ name }}" class="form-text text-muted">{{ help }}</small></div></div>
{% endmacro %}
{% import _self as fields %}
{{ fields.row('label','設定名','見分けやすい名前を付けます。例：旧Xmail、店舗用メール','text',edit.label|default(''),false) }}
<div class="mb-3 row"><label class="col-md-3 col-form-label" for="smtp-status">ステータス</label><div class="col-md-5"><select class="form-control" id="smtp-status" name="status"><option value="enabled"{% if edit.enabled is not defined or edit.enabled %} selected{% endif %}>有効</option><option value="disabled"{% if edit.enabled is defined and not edit.enabled %} selected{% endif %}>無効（登録のみ）</option></select></div><div class="col-md-4"><small class="form-text text-muted">「有効」にしても、現在の送信設定は自動で切り替わりません。</small></div></div>
{{ fields.row('sender_email','メールアドレス','お客様へ表示する送信元です。例：sender@example.com','email',edit.sender_email|default('')) }}
{{ fields.row('host','サーバー名','メール会社から案内された送信サーバー名を入力します。例：smtp.example.com','text',edit.host|default('')) }}
{{ fields.row('port','ポート番号','通常は587です。「SSL/TLS」を使う場合は465が一般的です。','number',edit.port|default('587')) }}
{{ fields.row('username','ユーザー名（通常は必須）','メールサーバーへのログイン名です。メールアドレスと同じ場合が多い項目です。','text',edit.username|default(''),false) }}
{{ fields.row('password','パスワード（通常は必須）','メール用パスワードを入力します。専用の「アプリパスワード」がある場合はそちらを使います。保存後は表示しません。' ~ (edit is defined ? '変更しない場合は空欄のままにします。' : ''),'password','',false) }}
<div class="mb-3 row"><label class="col-md-3 col-form-label" for="smtp-encryption">接続の保護 <span class="text-danger">*</span></label><div class="col-md-5"><select class="form-control" id="smtp-encryption" name="encryption"><option value="starttls"{% if edit.encryption|default('starttls')=='starttls' %} selected{% endif %}>STARTTLS（通常はこちら）</option><option value="tls"{% if edit.encryption|default('starttls')=='tls' %} selected{% endif %}>SSL/TLS</option></select></div><div class="col-md-4"><small class="form-text text-muted">メール会社の指定に合わせます。暗号化しない接続には対応していません。</small></div></div>
<details class="border rounded p-3 mt-3"><summary><strong>詳細設定（通常は変更不要）</strong></summary><p class="small text-muted mt-3">メール会社や管理担当者から案内された場合だけ設定してください。</p>
<div class="mb-3"><label for="smtp-auth-mode">サーバーへのログイン</label><select class="form-control" id="smtp-auth-mode" name="auth_mode"><option value="password"{% if edit.auth_mode|default('password')=='password' %} selected{% endif %}>ユーザー名とパスワードを使う（通常）</option><option value="none"{% if edit.auth_mode|default('password')=='none' %} selected{% endif %}>ログイン不要と案内されている</option></select><small class="form-text text-muted">ログイン不要を選ぶ場合、ユーザー名・パスワードには任意の仮入力をせず、空欄にしてください。</small></div>
<div class="mb-3"><label for="smtp-transport">クライアント証明書</label><select class="form-control" id="smtp-transport" name="transport"><option value="smtp"{% if edit.transport|default('smtp')=='smtp' %} selected{% endif %}>使わない（通常）</option><option value="certsmtp"{% if edit.transport|default('smtp')=='certsmtp' %} selected{% endif %}>使う（対応サーバー専用）</option></select><small class="form-text text-muted">通常のメールサーバーでは不要です。証明書方式はSTARTTLSに対応するサーバー専用です。メールアドレスとユーザー名を同じにし、16文字以上の専用パスワードを使います。</small></div>
<div class="mb-3"><label for="smtp-p12">証明書ファイル（P12 / PFX）</label><input class="form-control" type="file" id="smtp-p12" name="p12" accept=".p12,.pfx"><small class="form-text text-muted">証明書と鍵が一つになったファイルです。256KBまで。{% if edit is defined %}変更しない場合はファイルを選ばずに保存します。{% endif %}こちらを選んだ場合、下の証明書・秘密鍵は不要です。</small></div>
{{ fields.row('certificate_password','証明書のパスワード','新しく選んだP12ファイル、または秘密鍵を開くためのパスワードです。ファイルを選び直さない場合は空欄にします。','password','',false) }}
<details class="mt-3"><summary>P12以外のファイルを使う場合</summary><div class="mb-3 mt-3"><label for="smtp-certificate">クライアント証明書（PEM / CRT / CER）</label><input class="form-control" type="file" id="smtp-certificate" name="certificate" accept=".pem,.crt,.cer"></div><div class="mb-3"><label for="smtp-private-key">秘密鍵（PEM / KEY）</label><input class="form-control" type="file" id="smtp-private-key" name="private_key" accept=".pem,.key"><small class="form-text text-muted">証明書と組み合わせて使います。保存時に組み合わせ・期限・メールアドレスを確認します。各256KBまで。</small></div></details>
<div class="form-check mt-3"><input class="form-check-input" type="checkbox" name="allow_private_network" value="1" id="smtp-private-network"{% if edit.allow_private_network|default(false) %} checked{% endif %}><label class="form-check-label" for="smtp-private-network">社内ネットワーク内のメールサーバーを使う</label><small class="form-text text-muted">管理担当者から指定された場合だけ選んでください。通常は不要です。</small></div>
<p class="small text-muted mt-3 mb-0">パスワード・証明書・鍵は公開フォルダーの外で暗号化して保存します。ファイルの保管場所を入力する必要はありません。</p>
</details>
